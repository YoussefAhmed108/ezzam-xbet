# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=worldcup2026

# --- Auth ---
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173

# --- Football data API ---
# Provider: "football-data" or "api-football"
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=
# football-data.org uses competition code "WC"; api-football uses league id "1"
FOOTBALL_API_COMPETITION=WC
FOOTBALL_API_SEASON=2026

# --- Scoring / scheduling ---
# How often (minutes) the scheduler polls the football API for results
SCORE_SYNC_INTERVAL_MINUTES=15
# Hours before kickoff that predictions lock
PREDICTION_LOCK_HOURS=2

# Optional: secret required to call the manual admin sync endpoint
ADMIN_SYNC_TOKEN=
